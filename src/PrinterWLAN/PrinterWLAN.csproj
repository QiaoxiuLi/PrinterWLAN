<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PrinterWLAN</AssemblyName>
    <RootNamespace>PrinterWLAN</RootNamespace>
    <OutputType>Exe</OutputType>
    <Product>PrinterWLAN</Product>
    <Company>QIAOXIU LI</Company>
    <Copyright>Copyright © 2026 QIAOXIU LI</Copyright>
    <PublishSingleFile>false</PublishSingleFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      Some supported Windows 10 desktop builds cannot launch CET-compatible
      .NET apphosts. Keep the Server 2025 build hardened by default and opt out
      only for the separately gated desktop compatibility candidate.
    -->
    <CetCompat Condition="'$(PrinterWlanDesktopCompatibility)' == 'true'">false</CetCompat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\third-party\licenses\**\*" Link="third-party\licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)skiasharp/4.150.1/LICENSE.txt" Link="third-party\licenses\SkiaSharp-MIT.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)skiasharp/4.150.1/LICENSE.txt')" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WriteInstallerVersion" AfterTargets="Build">
    <ItemGroup>
      <_InstallerVersionLine Include="#define MyAppVersion &quot;$(ProductVersion)&quot;" />
      <_InstallerVersionLine Include="#define MyAppFileVersion &quot;$(FileVersion)&quot;" />
    </ItemGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\..\..\installer\generated-version.iss"
                      Lines="@(_InstallerVersionLine)"
                      Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
